[Unit]
# 주식선물 가격제한폭 확대 실시간 알림 봇 (StockYD)
# 이 파일은 템플릿입니다. install_service.sh가 __USER__ / __WORKDIR__ 를
# 실제 값으로 치환하여 /etc/systemd/system/stock-monitor.service 에 설치합니다.
#
# 서버에 이미 존재하던 서비스와 같은 이름을 사용합니다. 새 이름으로 서비스를
# 추가하면 supervisor가 둘이 되어 각자 봇을 띄우고 서로 죽이는 문제가 발생합니다.
Description=Stock Disclosure Monitor Service
Documentation=https://github.com/yukdal/StockYD
# 네트워크가 실제로 연결된 뒤에 기동 (재부팅 직후 DNS 실패 방지)
After=network-online.target
Wants=network-online.target
# 짧은 시간에 반복 실패해도 포기하지 않고 계속 재시도
# (KRX/텔레그램 일시 장애로 연속 크래시하는 상황 대비)
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKDIR__

# .env는 stock_monitor.py가 load_dotenv()로 직접 읽습니다.
# WorkingDirectory가 지정되어 있으므로 EnvironmentFile 설정은 불필요합니다.
# (systemd의 EnvironmentFile은 따옴표/공백 처리 규칙이 달라 .env를 그대로 넣으면 기동에 실패할 수 있습니다.)

# main.py가 아니라 stock_monitor.py를 직접 실행한다.
# main.py는 os.system()으로 stock_monitor.py를 띄우는 호환용 래퍼라
# 'sh -c' 중간 프로세스가 하나 더 생기고, ps 출력에서 다른 프로젝트의
# main.py와 헷갈려 잘못된 pkill 대상이 되기 쉽다.
# -u : 출력 버퍼링 해제 (journalctl에 로그가 즉시 보이도록)
ExecStart=__WORKDIR__/venv/bin/python -u stock_monitor.py

# 봇이 죽으면 항상 자동 재시작
Restart=always
RestartSec=30

# 이미 다른 봇이 실행 중이라 종료한 경우(종료 코드 3)에는 재시작하지 않는다.
# 재시작해봐야 계속 같은 이유로 종료되며, 두 인스턴스가 서로를 죽이는
# 무한 루프의 원인이 된다. stock_monitor.py의 EXIT_ALREADY_RUNNING과 값이 일치해야 한다.
RestartPreventExitStatus=3

# 이 서비스가 유일한 supervisor다. 봇이 스스로 다른 인스턴스를 죽이는
# 인수(takeover) 동작은 절대 켜지 않는다 (STOCKYD_TAKEOVER 미설정).

# SIGTERM으로 정상 종료 시도 후 20초가 지나면 강제 종료
KillSignal=SIGTERM
TimeoutStopSec=20

# 로그는 journald로 수집 (journalctl -u stock-monitor -f 로 확인)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stock-monitor

[Install]
WantedBy=multi-user.target
